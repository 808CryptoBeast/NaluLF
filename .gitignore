# ==============================
# FILE: .gitignore
# ==============================

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code — local, machine-specific permission settings; never shared config
.claude/settings.local.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node (build.mjs / esbuild tooling for the www/ production build)
node_modules/
.pnpm-store/
yarn.lock
pnpm-lock.yaml
# package-lock.json is committed on purpose — codemagic.yaml runs `npm ci`,
# which requires the lockfile to exist in the repo.

# Build outputs / cache
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.eslintcache

# Regenerated by `npm run build` (esbuild bundles NaluLF/ into this) — the
# live GitHub Pages deployment serves the repo root directly (index.html's
# script tag points at NaluLF/scripts/main.js, not www/'s rewritten path),
# and codemagic.yaml's iOS pipeline rebuilds this itself via `npm run build`
# before `cap sync` — so nothing actually depends on a committed copy.
www/

# Env
.env
.env.*
!.env.example

# Misc
*.bak
*.swp
*.tmp