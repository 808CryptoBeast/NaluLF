# ==============================
# FILE: .gitignore
# ==============================

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code — local, machine-specific permission settings; never shared config
.claude/settings.local.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node (Playwright test tooling only — the app itself has no build step)
node_modules/
.pnpm-store/
yarn.lock
pnpm-lock.yaml

# Build outputs / cache
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.eslintcache

# Env
.env
.env.*
!.env.example

# Misc
*.bak
*.swp
*.tmp