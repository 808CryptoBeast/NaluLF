# ==============================
# FILE: .gitignore
# ==============================

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node (build.mjs / esbuild tooling for the www/ production build)
node_modules/
.pnpm-store/
yarn.lock
pnpm-lock.yaml
# package-lock.json is committed on purpose — codemagic.yaml runs `npm ci`,
# which requires the lockfile to exist in the repo.

# Build outputs / cache
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.eslintcache

# Exception: the React Profile app's compiled bundle IS a runtime asset the
# vanilla-JS app loads via a plain <script> tag (see index.html) — there's no
# CI build step for NaluLF/ that would regenerate it, so it must be committed.
!NaluLF/scripts/profile-app/dist/
!NaluLF/scripts/profile-app/dist/**

# Env
.env
.env.*
!.env.example

# Misc
*.bak
*.swp
*.tmp