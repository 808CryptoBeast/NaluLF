# ==============================
# FILE: .gitignore
# ==============================

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code — local, machine-specific permission settings; never shared config
.claude/settings.local.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node (build.mjs / esbuild tooling for the www/ production build)
node_modules/
.pnpm-store/
yarn.lock
pnpm-lock.yaml
# package-lock.json is committed on purpose — codemagic.yaml runs `npm ci`,
# which requires the lockfile to exist in the repo.

# Build outputs / cache
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.eslintcache

# Env
.env
.env.*
!.env.example

# Misc
*.bak
*.swp
*.tmp